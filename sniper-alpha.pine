//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// SNIPER_ALPHA — 1m execution layer (Stoch Quad Rotation)
// ───────────────────────────────────────────────────────────────────────────
// Hosts two entry strategies — SQRC · SQRR — each long & short. The Stoch Quad
// Oscillator (four stochastics) is shared CONTEXT only: no pane plots, its calcs
// feed the gates. The two engines are FULLY INDEPENDENT — own inputs, gates,
// risk, tracker, stats and alerts; one open position PER ENGINE. Shared context
// only: oscillator, fractal BOS, DTQ bias, 6h containers / 90m quarters.
//   SQRC · Stoch Quad Rotation Continuation — deferred completion of SQRR.
//     A rotation whose D-cross fires but FAILS its swing validation is captured
//     as SQRC's PENDING (SQRR's own latch is untouched). The next side-relevant
//     confirmed swing decides it: HL above the rotation level (long) / LH below
//     (short) → fill. Stop: per-asset FIXED %; fixed-R target.
//   SQRR · Stoch Quad Rotation Reversal — 6h CONTAINER anchor, trades AGAINST bias.
//     sweep prev container (G1) → all four stochs latched (G2) → counter-BOS in
//     the G3 window (G3) → D9 / D14 cross back out, trigger bar prints a local
//     HL (long) / LH (short) vs the last confirmed swing inside the current 90m
//     quarter → fill. Stop: per-asset FIXED %; fixed-R target.
// Engines are independent and run unconditionally; the strategies gate off them.
//   Quarter (90m) · Container (6h) · DTQ Bias · Stoch Quad · Structure (BOS) · Trade Tracker
// Library: Sniper_Ammo (structure BOS · order blocks · killzone resolver · bias · payload)
// Tracker: breakeven @ 0.5R — stats/backtest only, NOT on the alert path.
// ═══════════════════════════════════════════════════════════════════════════
indicator("SNIPER_ALPHA", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

import Wen_Rich/Sniper_Ammo/14 as ammo


// ═══ CONSTANTS ═══════════════════════════════════════════════════════════════
int DIRECTION_NONE  = 0
int DIRECTION_LONG  = 1
int DIRECTION_SHORT = -1

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

// ── General ──
generalGroup = "General"
anchorTimezone = input.string("Australia/Sydney", "Timezone",
     options = ["America/New_York", "Europe/London", "Asia/Tokyo", "Australia/Sydney", "UTC"],
     group = generalGroup, tooltip = "Quarter math, sessions and the weekly anchor use this timezone.")
historyLookbackDays = input.int(3, "History / lookback (days)", minval = 1, maxval = 7, group = generalGroup)

// ── Execution / Routing ──
routingGroup = "Execution / Routing"
executionTarget = input.string("dc_exness_mt5_01", "Execution target (MT5 instance)",
     options = ["dc_exness_mt5_01", "nexus_ftmo_mt5_01"], group = routingGroup,
     tooltip = "Routed into every payload's execution target. Pick the MT5 instance the bridge delivers to.")
brokerSymbolOverride = input.string("", "Broker symbol override", group = routingGroup,
     tooltip = "Optional MT5/Exness symbol override. Leave blank to use the TradingView ticker.")
blockNewEntriesWhileTradeOpen = input.bool(true, "Block new entries while that engine is in trade", group = routingGroup,
     tooltip = "One active trade PER ENGINE. While an SQRC trade is open no new SQRC setup arms; likewise SQRR. The two engines are independent of each other.")

// ── Quarterly Anchor ──
quarterlyAnchorGroup = "Quarterly Anchor Time"
sessionAnchorStartHour = input.int(10, "S1 start hour (local time)", minval = 0, maxval = 23, group = quarterlyAnchorGroup,
     tooltip = "Local hour the quarterly structure anchors from. The 6h containers and 90m quarters tile forward from here.")

// ── Quarter Visuals ──
quarterVisualsGroup = "Quarter Visuals"
showHourContainerBox = input.bool(true,  "Show 6h container",       group = quarterVisualsGroup)
showQuarterBoxes     = input.bool(true,  "Show 90m quarter boxes",  group = quarterVisualsGroup)
showQuarterLabels    = input.bool(false, "Show A/M/D/C labels",     group = quarterVisualsGroup)

// ── Phase Colours ──
phaseColoursGroup = "Phase Colours (A · M · D · C)"
accumulationColor = input.color(color.new(#2962FF, 85), "A — Accumulation", group = phaseColoursGroup)
manipulationColor = input.color(color.new(#E91E63, 85), "M — Manipulation", group = phaseColoursGroup)
distributionColor = input.color(color.new(#26A69A, 85), "D — Distribution", group = phaseColoursGroup)
continuationColor = input.color(color.new(#9E9E9E, 85), "C — Continuation", group = phaseColoursGroup)

// ── Structure Engine ──
structureGroup = "Structure"
internalPivotLength   = input.int(25, "Internal pivot length", minval = 1, group = structureGroup, tooltip = "ammo.run internalLen — lower = more/earlier breaks. Drives the BOS that SQRR's Gate 3 reads.")
swingPivotLength      = input.int(50, "Swing pivot length", minval = 1, group = structureGroup, tooltip = "ammo.run swingLen — the reference an internal break must DIFFER from to validate.")
structureConfluence   = input.bool(true,  "Confluence filter", group = structureGroup, tooltip = "ammo.run confluence — also require a body-position confluence bar.")
structurePresentMode  = input.bool(false, "Present mode (reuse latest line)", group = structureGroup, tooltip = "ammo.run present — true reuses one structure line; false keeps each historical break line.")
showStructureBreaks   = input.bool(true, "Draw structure breaks", group = structureGroup)
bullishStructureColor = input.color(#089981, "Bullish colour", group = structureGroup)
bearishStructureColor = input.color(#f23645, "Bearish colour", group = structureGroup)
swingDetectorLength   = input.int(21, "Swing detector length (SQRR stop)", minval = 1, group = structureGroup, tooltip = "Standalone LuxAlgo swing detector (ammo.advanceSwing) — SEPARATE from the BOS engine above. Left=right=this many bars, so a swing confirms this many bars after it prints. SQRR anchors its stop to the most recent CONFIRMED swing (low for long / high for short) wick extreme.")

// ── Order Block Engine (kept for future use; ALPHA does not trade OBs) ──
orderBlockGroup = "Order Blocks"
showOrderBlocks       = input.bool(false, "Show order blocks", group = orderBlockGroup)
maxOrderBlocksKept    = input.int(5, "Max OBs kept / drawn", minval = 1, maxval = 20, group = orderBlockGroup,
     tooltip = "Passed to the library SMC engine (run maxOB).")
orderBlockFilter      = input.string("Atr", "OB volatility filter", options = ["Atr", "Cumulative Mean Range"], group = orderBlockGroup,
     tooltip = "How the library anchors the OB candle. Atr = ATR(200); Cumulative Mean Range = running mean true range.")
orderBlockMitigation  = input.string("High/Low", "OB mitigation", options = ["Close", "High/Low"], group = orderBlockGroup,
     tooltip = "Close = OB dies only when price CLOSES through it. High/Low = a wick through removes it.")
demandOrderBlockColor = input.color(color.new(#3179f5, 0), "Demand (bull) OB colour", group = orderBlockGroup)
supplyOrderBlockColor = input.color(color.new(#f77c80, 0), "Supply (bear) OB colour", group = orderBlockGroup)

// ── SQRC Strategy ──
sqrcGroup = "SQRC · Signals"
sqrcShowGateMarkers = input.bool(true, "Mark gates (debug)", group = sqrcGroup,
     tooltip = "Marker at the SQRC handoff (C·PEND·L/S — a rotation's D-cross fired but its swing validation failed, captured as SQRC's pending).")
sqrcGateMarkerColor = input.color(color.new(#AB47BC, 0), "Gate marker colour", group = sqrcGroup)
sqrcSignalColor     = input.color(color.new(#26C6DA, 0), "Signal colour",      group = sqrcGroup)

// ── SQRR Strategy ──
sqrrGroup = "SQRR · Signals"
sqrrShowGateMarkers = input.bool(true, "Mark gates (debug)", group = sqrrGroup,
     tooltip = "Marker when the quad-stoch latch (G2) sets, at the counter-BOS (G3), and at the D9/D14 cross-back trigger.")
sqrrGateMarkerColor = input.color(color.new(#AB47BC, 0), "Gate marker colour", group = sqrrGroup)
sqrrSignalColor     = input.color(color.new(#FFB300, 0), "Signal colour",      group = sqrrGroup)

// ── Risk & Stats ──
riskStatsGroup = "Risk & Stats"
showTradeZoneBoxes = input.bool(true, "Show SL/TP zone boxes", group = riskStatsGroup)
showStatsTable     = input.bool(true, "Show stats table",      group = riskStatsGroup)
riskDollarsPerR    = input.float(50, "Risk per 1R ($, stats only)", minval = 1, group = riskStatsGroup)
moveStopToBreakeven = input.bool(true, "Move stop to breakeven at 50% of stop distance", group = riskStatsGroup,
     tooltip = "TRACKER ONLY — never touches alerts/EA. Once price moves 0.5R in favour, the tracked stop moves to entry and the trade runs to target. Exits at entry count as BE (0R), not a loss.")

// ── Dashboard ──
dashboardGroup = "Dashboard"
showUnifiedDashboard = input.bool(true, "Show SNIPER_ALPHA dashboard", group = dashboardGroup)

// ═══════════════════════════════════════════════════════════════════════════
// CONFIG TYPES — the shape of an asset's configuration
// ═══════════════════════════════════════════════════════════════════════════
// Killzone schedule is HOST-HELD and CONTAINER-ALIGNED: a list of active CONTAINER
// SLOTS (ammo.KillzoneContainer), each carrying which of its four 90m quarters
// (A/M/D/C = quarterIndex 1/2/3/4) trade. The library query (ammo.isKillzoneOpenByContainer)
// reads the host's own containerIndex + quarterIndex (from resolveContainerQuarter
// with 6h / 90m sizing) — no separate time math, so it can't drift from the
// container/quarter clock. ONE killzone per asset, SHARED by both engines (SQRC / SQRR).
type KillzoneConfig
    bool   restrictEnabled
    array<ammo.KillzoneHour> activeHours

// Shared bias settings (DTQ quarter bias). No volume engine in ALPHA.
type SharedConfig
    int    biasConfirmCount

// Per-asset FIXED stop. One number, all entry modes (TRIG, DEC, staged): stop =
// entry ± this % of price; target = engine targetRMultiple × that distance.
// Structural stop levels and the min/max band are retired from the live paths.
type RiskConfig
    float  fixedStopPercent    // fixed stop distance as % of entry price

// SQRC — Stoch Quad Rotation Continuation (deferred completion of SQRR).
//   biasFilterEnabled : OPTIONAL DTQ bias agreement (validation; off → both sides)
//   targetRMultiple   : target = this multiple of the fixed stop distance
//   ENTRY MODES (per asset):
//     entryDec = DEC · deferred swing-decision entry (the original SQRC path)
//     entryL1  = L1/S1 · immediate entry on the handoff bar (replaces DEC when true)
type SqrcConfig
    bool   enabled
    bool   biasFilterEnabled
    float  targetRMultiple
    bool   entryDec
    bool   entryL1

// SQRR — Stoch Quad Rotation Reversal (6h container anchor, trades AGAINST bias).
//   gate1Enabled          : OPTIONAL prev-container sweep (G1)
//   gate3Enabled          : OPTIONAL counter-BOS confirmation (G3)
//   gate3WindowQuarters   : G3 must land within this many 90m quarters of the latch
//   biasFilterEnabled     : OPTIONAL DTQ bias opposition (validation; off → both sides)
//   targetRMultiple       : target = this multiple of the fixed stop distance
//   ENTRY MODES (per asset):
//     entryTrig = classic D-cross + swing-validation entry (the original SQRR path)
//     entryL1   = L1/S1 · Gate 1 container-sweep bar
//     entryL2   = L2/S2 · Gate 2 quad-latch bar
//     entryL3   = L3/S3 · Gate 3 counter-BOS bar
type SqrrConfig
    bool   enabled
    string trigMode              // "Ultra Fast" (D9) | "Fast" (D14)
    bool   gate1Enabled
    bool   gate3Enabled
    int    gate3WindowQuarters
    bool   biasFilterEnabled
    float  targetRMultiple
    bool   entryTrig
    bool   entryL1
    bool   entryL2
    bool   entryL3

type AssetConfig
    string         assetCode
    bool           isKnownAsset
    SharedConfig   shared
    RiskConfig     risk
    KillzoneConfig killzone        // shared by SQRC / SQRR
    SqrcConfig     sqrc
    SqrrConfig     sqrr

// ── killzone helper ──────────────────────────────────────────────────────────
// Container-aligned: enable a whole container slot (0–3) with all four 90m quarters
// tradeable. SQRR gates at container level (any quarter in an active container is
// fine); SQRC reads the quarter dimension. To restrict specific quarters, build a
// KillzoneContainer by hand instead of using this helper.
activeHour(int hourOfDay) =>
    ammo.KillzoneHour.new(hourOfDay, false, true, true, true)

// ═══════════════════════════════════════════════════════════════════════════
// PER-ASSET CONFIG — one self-contained block per asset (no base + override).
// Each block spells out EVERYTHING that asset uses: stop band, both engine enables,
// every engine's tuning, and its killzone containers inline. Read one block
// top-to-bottom and you know exactly how that asset trades.
//   Container slots (S1 anchor = 10:00):  0 = 10:00–16:00 · 1 = 16:00–22:00
//                                         2 = 22:00–04:00 · 3 = 04:00–10:00
//   STOP BANDS + KILLZONE CONTAINERS below are placeholders — tune per asset.
// ═══════════════════════════════════════════════════════════════════════════

// ── AUD/JPY (FX major) ──
buildConfigAUDJPY() =>
    array<ammo.KillzoneHour> killzoneHours = array.new<ammo.KillzoneHour>()
    array.push(killzoneHours, activeHour(0))
    array.push(killzoneHours, activeHour(1))
    array.push(killzoneHours, activeHour(2))
    array.push(killzoneHours, activeHour(3))
    array.push(killzoneHours, activeHour(4))
    array.push(killzoneHours, activeHour(7))
    array.push(killzoneHours, activeHour(8))
    array.push(killzoneHours, activeHour(9))
    array.push(killzoneHours, activeHour(10))
    array.push(killzoneHours, activeHour(11))
    array.push(killzoneHours, activeHour(12))
    array.push(killzoneHours, activeHour(13))
    array.push(killzoneHours, activeHour(14))
    array.push(killzoneHours, activeHour(15))
    array.push(killzoneHours, activeHour(16))
    array.push(killzoneHours, activeHour(17))
    array.push(killzoneHours, activeHour(18))
    array.push(killzoneHours, activeHour(19))
    array.push(killzoneHours, activeHour(20))
    array.push(killzoneHours, activeHour(21))
    array.push(killzoneHours, activeHour(22))
    array.push(killzoneHours, activeHour(23))
    AssetConfig.new("AUDJPY", true,
         SharedConfig.new(biasConfirmCount = 1),
         RiskConfig.new(fixedStopPercent = 0.07),   // seed = old band min — tune
         KillzoneConfig.new(restrictEnabled = true, activeHours = killzoneHours),
         SqrcConfig.new(enabled = false, biasFilterEnabled = true, targetRMultiple = 3.0, entryDec = true, entryL1 = false),
         SqrrConfig.new(enabled = true, trigMode = "Fast", gate1Enabled = true, gate3Enabled = true, gate3WindowQuarters = 1, biasFilterEnabled = true, targetRMultiple = 1.0, entryTrig = false, entryL1 = true, entryL2 = false, entryL3 = true))

