//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// SNIPER_BRAVO v2 — 1m scalp-precision execution layer (Quarterly Theory)
// ───────────────────────────────────────────────────────────────────────────
// v2 CHANGES (from v1):
//   · STOP BAND: the tightened structural stop is now bounded by a per-asset
//     MIN/MAX band (% of price), matching SNIPER_ALPHA v2:
//       tightened distance < min → stop WIDENED to the min distance
//       tightened distance > max → entry SKIPPED (grey SKIP marker)
//     NOTE: a min-widen can place the stop BEYOND the measured structural
//     level (further than the untightened distance) when the measured move
//     is small — the stop is wider, never inside the tighten geometry.
//   · STOP CONFIG IS PER-STRATEGY, PER-ASSET: tighten % + min/max band live
//     inside each strategy's config (CbrConfig / F2Config) — no shared global
//     tighten input, no shared band. CBR and F2 tune independently per asset,
//     matching the suite plan's "Structural Stop Settings per setup" model.
//   · ALERT FIX: payloads read the signal-bar locals (not the tracker), so a
//     fire while the lock is off and a trade is open can no longer emit the
//     PREVIOUS trade's entry/SL/TP.
// Hosts two entry strategies — CBR · F2 — each long & short, sharing one
// structure read, one bias engine, one trade tracker (single open position
// across both), and per-strategy SupaCron alerts.
//   CBR ENTRY MODES (per asset, ALPHA-style toggles + entryTag on the alert):
//     entryL1 / entryS1 · G1-confirm bar entry, long / short (structural tighten stop, banded)
//     entryL2 / entryS2 · mitigated wick entry, long / short (same structural stop as L1/S1, banded)
// Engines are independent and run unconditionally; the strategies gate off them.
//   Quarter · DQT Bias · Volume · Volatility · Structure (MSB + OB) · Trade Tracker
// Library: Sniper_Ammo (structure BOS · order blocks · killzone resolver · bias · payload)
// Tracker: breakeven @ 0.5R — stats/backtest only, NOT on the alert path.
// ═══════════════════════════════════════════════════════════════════════════
indicator("SNIPER_BRAVO", overlay = true, precision = 2,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

import Wen_Rich/Sniper_Ammo/14 as ammo

// ═══ CONSTANTS ═══════════════════════════════════════════════════════════════
int DIRECTION_NONE  = 0
int DIRECTION_LONG  = 1
int DIRECTION_SHORT = -1

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

// ── General ──
generalGroup = "General"
anchorTimezone = input.string("Australia/Sydney", "Timezone",
     options = ["America/New_York", "Europe/London", "Asia/Tokyo", "Australia/Sydney", "UTC"],
     group = generalGroup, tooltip = "Quarter math, sessions and the weekly anchor use this timezone.")
historyLookbackDays = input.int(3, "History / lookback (days)", minval = 1, maxval = 7, group = generalGroup)

// ── Execution / Routing ──
routingGroup = "Execution / Routing"
executionTarget = input.string("dc_exness_mt5_01", "Execution target (MT5 instance)",
     options = ["dc_exness_mt5_01", "nexus_ftmo_mt5_01"], group = routingGroup,
     tooltip = "Routed into every payload's execution target. Pick the MT5 instance the bridge delivers to.")
brokerSymbolOverride = input.string("", "Broker symbol override", group = routingGroup,
     tooltip = "Optional MT5/Exness symbol override. Leave blank to use the TradingView ticker.")
blockNewEntriesWhileTradeOpen = input.bool(true, "Block new entries while any trade is open", group = routingGroup,
     tooltip = "One active trade across CBR L1, CBR L2 and F2. Developing setups are cleared while another engine is in trade.")

// ── Quarterly Anchor ──
quarterlyAnchorGroup = "Quarterly Anchor Time"
sessionAnchorStartHour = input.int(10, "S1 start hour (local time)", minval = 0, maxval = 23, group = quarterlyAnchorGroup,
     tooltip = "Local hour the quarterly structure anchors from. The 1h containers and 15m quarters tile forward from here.")

// ── Quarter Visuals ──
quarterVisualsGroup = "Quarter Visuals"
showHourContainerBox = input.bool(true,  "Show hourly container",   group = quarterVisualsGroup)
showQuarterBoxes     = input.bool(true,  "Show 15m quarter boxes",  group = quarterVisualsGroup)
showQuarterLabels    = input.bool(false, "Show A/M/D/C labels",     group = quarterVisualsGroup)

// ── Phase Colours ──
phaseColoursGroup = "Phase Colours (A · M · D · C)"
accumulationColor = input.color(color.new(#2962FF, 85), "A — Accumulation", group = phaseColoursGroup)
manipulationColor = input.color(color.new(#E91E63, 85), "M — Manipulation", group = phaseColoursGroup)
distributionColor = input.color(color.new(#26A69A, 85), "D — Distribution", group = phaseColoursGroup)
continuationColor = input.color(color.new(#9E9E9E, 85), "C — Continuation", group = phaseColoursGroup)

// ── Structure Engine ──
structureGroup = "Structure"
internalPivotLength   = input.int(10, "Internal pivot length", minval = 1, group = structureGroup, tooltip = "ammo.run internalLen — lower = more/earlier breaks. Drives BOS/MSB + OB anchoring.")
swingPivotLength      = input.int(50, "Swing pivot length", minval = 1, group = structureGroup, tooltip = "ammo.run swingLen — the reference an internal break must DIFFER from to validate.")
structureConfluence   = input.bool(true,  "Confluence filter", group = structureGroup, tooltip = "ammo.run confluence — also require a body-position confluence bar.")
structurePresentMode  = input.bool(false, "Present mode (reuse latest line)", group = structureGroup, tooltip = "ammo.run present — true reuses one structure line; false keeps each historical break line.")
showStructureBreaks   = input.bool(true, "Draw structure breaks", group = structureGroup)
bullishStructureColor = input.color(#089981, "Bullish colour", group = structureGroup)
bearishStructureColor = input.color(#f23645, "Bearish colour", group = structureGroup)

// ── Order Block Engine ──
orderBlockGroup = "Order Blocks"
showOrderBlocks       = input.bool(true, "Show order blocks", group = orderBlockGroup)
maxOrderBlocksKept    = input.int(5, "Max OBs kept / drawn", minval = 1, maxval = 20, group = orderBlockGroup,
     tooltip = "Passed to the library SMC engine (run maxOB).")
orderBlockFilter      = input.string("Atr", "OB volatility filter", options = ["Atr", "Cumulative Mean Range"], group = orderBlockGroup,
     tooltip = "How the library anchors the OB candle. Atr = ATR(200); Cumulative Mean Range = running mean true range.")
orderBlockMitigation  = input.string("High/Low", "OB mitigation", options = ["Close", "High/Low"], group = orderBlockGroup,
     tooltip = "Close = OB dies only when price CLOSES through it. High/Low = a wick through removes it.")
demandOrderBlockColor = input.color(color.new(#3179f5, 0), "Demand (bull) OB colour", group = orderBlockGroup)
supplyOrderBlockColor = input.color(color.new(#f77c80, 0), "Supply (bear) OB colour", group = orderBlockGroup)

// ── CBR Strategy ──
cbrGroup = "CBR · Signals"
cbrShowGate1Markers     = input.bool(true, "Mark Gate 1 (debug)", group = cbrGroup,
     tooltip = "Marker at the manipulation quarter's first bar when its close lands beyond the previous candle container's high/low, showing the trade direction.")
cbrGate1MarkerColor     = input.color(color.new(#AB47BC, 0), "Gate 1 marker colour", group = cbrGroup)
cbrShowManipulationWick = input.bool(true, "Mark manipulation wick", group = cbrGroup,
     tooltip = "↯ marker at the first tagged wick of the manipulation leg inside Q2 — only wicks whose extreme sits inside the previous candle container count; a wick through its far side invalidates the setup.")
cbrWickMarkerColor      = input.color(color.new(#FFB300, 0), "Wick marker colour", group = cbrGroup)
cbrEntryWaitBars        = input.int(3, "Entry wick wait (bars into Q3)", minval = 0, group = cbrGroup,
     tooltip = "The reversal entry wick cannot fire until this many bars of the distribution quarter have completed (0 = the first Q3 bar is eligible). Lets the G2 extreme extend before entry — same idea as the F2 MSB wait.")
cbrSignalColor          = input.color(color.new(#26C6DA, 0), "Signal colour", group = cbrGroup)

// ── F2 Strategy ──
f2Group = "F2 · Signals"
f2ShowContainerShade      = input.bool(true, "Shade expansion container", group = f2Group,
     tooltip = "Gate 1: a completed container that swept BOTH sides of the prior container. Its final-bar close direction sets the bias for the NEXT container.")
f2ContainerBullishShade   = input.color(color.new(#26A69A, 80), "Bullish expansion shade", group = f2Group)
f2ContainerBearishShade   = input.color(color.new(#EF5350, 80), "Bearish expansion shade", group = f2Group)
f2ShowFailedQuarterMarker = input.bool(true, "Mark failed-2 quarter", group = f2Group,
     tooltip = "Gate 2: a quarter of the armed container that swept ONE side of the prior quarter and failed to close past it. Marks the swept extreme.")
f2FailedQuarterMarkerColor = input.color(color.new(#FFB300, 0), "Failed-2 marker colour", group = f2Group)
f2MsbWaitBars = input.int(15, "MSB wait after failed-2 (bars)", minval = 0, group = f2Group,
     tooltip = "Gate 3: after a failed-2 confirms, the entry waits up to this many bars for a fresh MSB in the bias direction (same bar counts). The wait survives the container boundary, so a failed-2 late in the container still gets its full window. MSB inside the window → entry at that bar's close. Window elapses → the trigger is dropped; a later failed-2 in the armed container can re-arm.")
f2SignalColor             = input.color(color.new(#7E57C2, 0), "Signal colour", group = f2Group)

// ── Risk & Stats ──
riskStatsGroup = "Risk & Stats"
// NOTE: the stop tighten % and min/max band are PER-STRATEGY, PER-ASSET —
// see CbrConfig / F2Config in each asset block.
showTradeZoneBoxes = input.bool(true, "Show SL/TP zone boxes", group = riskStatsGroup)
showStatsTable     = input.bool(true, "Show stats table",      group = riskStatsGroup)
riskDollarsPerR    = input.float(50, "Risk per 1R ($, stats only)", minval = 1, group = riskStatsGroup)
moveStopToBreakeven = input.bool(true, "Move stop to breakeven at 50% of stop distance", group = riskStatsGroup,
     tooltip = "TRACKER ONLY — never touches alerts/EA. Once price moves 0.5R in favour, the tracked stop moves to entry and the trade runs to target. Exits at entry count as BE (0R), not a loss.")

// ── Dashboard ──
dashboardGroup = "Dashboard"
showUnifiedDashboard = input.bool(true, "Show SNIPER_BRAVO dashboard", group = dashboardGroup)

// ═══════════════════════════════════════════════════════════════════════════
// CONFIG TYPES — the shape of an asset's configuration
// ═══════════════════════════════════════════════════════════════════════════
// Killzone schedule is HOST-HELD: a list of active CLOCK HOURS (ammo.KillzoneHour),
// each carrying which quarters (A/M/D/C) trade in that hour. The library query
// (ammo.isKillzoneOpen) reads the host's own hourLocal + quarterIndex — no separate
// time math, so it can't drift from the container/quarter clock. ONE killzone per
// asset, SHARED by both strategies (CBR / F2).
type KillzoneConfig
    bool   restrictEnabled
    array<ammo.KillzoneHour> activeHours

// Shared bias / volume settings (was ShCfg, minus the stop toggle)
type SharedConfig
    bool   volumeGateEnabled
    float  volumeThreshold
    int    biasConfirmCount

// CBR strategy — A·M·D reversal, container/quarter-anchored.
//   targetRMultiples : per entry mode — target = multiple × the stop distance
//   ENTRY MODES (per asset, PER DIRECTION — four booleans; all fire into the
//   ONE CBR tracker and the ONE CBR alert path, tagged L1/S1 · L2/S2):
//     entryL1 / entryS1 · immediate entry at the G1 confirm bar's close
//               (L1 = LONG confirms, S1 = SHORT confirms).
//               STOP = tighten % of the measured distance close → the just-closed
//               Q1's push-side extreme (high for SHORT / low for LONG), then
//               bounded by the per-asset min/max band.
//     entryL2 / entryS2 · the mitigated wick entry (L2 = LONG, S2 = SHORT).
//               G3 (the Q2 origin wick / mitigation) occurs first, then the G2
//               entry wick in Q3 — higher conviction. STOP = same methodology
//               as L1/S1: tighten % of close → the previously closed quarter's
//               (Q2's) relevant extreme, then bounded by the band.
type CbrConfig
    bool   enabled              // gates the whole CBR machine (G1 flag onward)
    float  wickRatio
    float  stopTightenPercent   // % of the measured close→structural-extreme distance
    float  minStopPercent       // tightened stop closer than this (% of price) → widened to this
    float  maxStopPercent       // tightened stop wider than this (% of price) → entry skipped
    float  l1TargetRMultiple
    float  l2TargetRMultiple
    bool   entryL1
    bool   entryS1
    bool   entryL2
    bool   entryS2

// F2 strategy — gate framework v3 (expansion → failed-2 → MSB entry).
// No bias mode, no killzone, no FVG, no wick trigger. Entry fires on the first
// same-direction structure break after a failed-2 arms. STOP = the CBR-L1
// structural methodology: measure close → the previously CLOSED quarter's
// relevant extreme (low for LONG / high for SHORT), tighten to F2's own
// per-asset stop-tighten %, then bounded by F2's per-asset min/max band. Target = fixed R
// off the stop distance. No resolveEntry.
type F2Config
    bool   enabled
    float  stopTightenPercent   // % of the measured close→structural-extreme distance
    float  minStopPercent       // tightened stop closer than this (% of price) → widened to this
    float  maxStopPercent       // tightened stop wider than this (% of price) → entry skipped
    float  targetRMultiple

type AssetConfig
    string         assetCode
    bool           isKnownAsset
    SharedConfig   shared
    KillzoneConfig killzone        // shared by CBR / F2
    CbrConfig      cbr
    F2Config       f2

// ── killzone helper ──────────────────────────────────────────────────────────
// Within each active hour ALL quarters trade — A/M/D/C. The continuation
// quarter is open because CBR's Gate 1 confirm reads the PREVIOUS container's
// Q4 as its reference quarter.
reversalHour(int hourOfDay) =>
    ammo.KillzoneHour.new(hourOfDay, true, true, true, true)

// ═══════════════════════════════════════════════════════════════════════════
// PER-ASSET CONFIG — one self-contained block per asset (no base + override).
// Each block spells out EVERYTHING that asset uses: the strategy enables,
// every strategy's tuning (entry modes, targets), and its killzone hours inline.
// Read one block top-to-bottom and you know exactly how that asset trades.
// ═══════════════════════════════════════════════════════════════════════════

// ── XAU (gold) — also the fallback for unknown tickers ──
buildConfigXAUUSD(string assetCode, bool isKnownAsset) =>
    array<ammo.KillzoneHour> killzoneHours = array.new<ammo.KillzoneHour>()
    array.push(killzoneHours, reversalHour(1))
    array.push(killzoneHours, reversalHour(2))
    array.push(killzoneHours, reversalHour(3))
    array.push(killzoneHours, reversalHour(4))
    array.push(killzoneHours, reversalHour(5))
    array.push(killzoneHours, reversalHour(10))
    array.push(killzoneHours, reversalHour(11))
    array.push(killzoneHours, reversalHour(12))
    array.push(killzoneHours, reversalHour(13))
    array.push(killzoneHours, reversalHour(14))
    array.push(killzoneHours, reversalHour(15))
    array.push(killzoneHours, reversalHour(16))
    array.push(killzoneHours, reversalHour(17))
    array.push(killzoneHours, reversalHour(18))
    array.push(killzoneHours, reversalHour(19))
    array.push(killzoneHours, reversalHour(20)) 
    array.push(killzoneHours, reversalHour(21))
    array.push(killzoneHours, reversalHour(22))
    array.push(killzoneHours, reversalHour(23))
    AssetConfig.new(assetCode, isKnownAsset,
         SharedConfig.new(volumeGateEnabled = false, volumeThreshold = 1.5, biasConfirmCount = 1),
         KillzoneConfig.new(restrictEnabled = true, activeHours = killzoneHours),
         CbrConfig.new(enabled = true, wickRatio = 0.10, stopTightenPercent = 50, minStopPercent = 0.15, maxStopPercent = 0.20, l1TargetRMultiple = 1.0, l2TargetRMultiple = 3.0, entryL1 = true, entryS1 = true, entryL2 = true, entryS2 = true),
         F2Config.new(enabled = false, stopTightenPercent = 50, minStopPercent = 0.10, maxStopPercent = 0.20, targetRMultiple = 1.5))


