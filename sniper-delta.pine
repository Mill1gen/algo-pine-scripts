//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// SNIPER_DELTA — 1m execution layer
// ───────────────────────────────────────────────────────────────────────────
// Strategy: DEX (Doyle Exchange Model) — order-block rejection signal.
//   A candle wicks into a drawn order block and closes back out of it; the
//   trade enters on the CLOSE of the following bar. Single open position.
// Engines are independent and run unconditionally; DEX gates off their outputs.
//   Quarterly · Bias · Volume · Order Block · Trade Tracker
// Library: Sniper_Ammo (structure BOS · order blocks · killzone resolver · bias · payload)
// Tracker: breakeven @ 0.5R — stats/backtest only, NOT on the alert path.
// ═══════════════════════════════════════════════════════════════════════════
indicator("SNIPER_DELTA", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

import Wen_Rich/Sniper_Ammo/14 as ammo

// ═══ CONSTANTS ═══════════════════════════════════════════════════════════════
int DIRECTION_NONE  = 0
int DIRECTION_LONG  = 1
int DIRECTION_SHORT = -1

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

// ── General ──
generalGroup = "General"
anchorTimezone = input.string("Australia/Sydney", "Timezone",
     options = ["America/New_York", "Europe/London", "Asia/Tokyo", "Australia/Sydney", "UTC"],
     group = generalGroup, tooltip = "Quarter math, sessions and the weekly anchor use this timezone.")
historyLookbackDays = input.int(3, "History / lookback (days)", minval = 1, maxval = 7, group = generalGroup)

// ── Execution / Routing ──
routingGroup = "Execution / Routing"
executionTarget = input.string("dc_exness_mt5_01", "Execution target (MT5 instance)",
     options = ["dc_exness_mt5_01", "nexus_ftmo_mt5_01"], group = routingGroup, tooltip = "MT5 instance the webhook routes to.")
brokerSymbolOverride = input.string("", "Broker symbol override", group = routingGroup,
     tooltip = "Optional MT5/Exness symbol override. Leave blank to use the TradingView ticker.")
blockNewEntriesWhileTradeOpen = input.bool(true, "Block new entries while any trade is open", group = routingGroup,
     tooltip = "One active trade at a time. While a DEX trade is open, developing setups are cleared. Kept multi-strategy ready for future trend-following engines bolted into DELTA.")

// ── Quarterly Anchor ──
quarterlyAnchorGroup = "Quarterly Anchor Time"
sessionAnchorStartHour = input.int(10, "S1 start hour (local time)", minval = 0, maxval = 23, group = quarterlyAnchorGroup,
     tooltip = "Local hour the quarterly structure anchors from. The 1h containers and 15m quarters tile forward from here.")

// ── Quarter Visuals ──
quarterlyVisualsGroup = "Quarter Visuals"
showHourContainerBox = input.bool(true, "Show 1h container box",  group = quarterlyVisualsGroup)
showQuarterBoxes     = input.bool(true, "Show 15m quarter boxes", group = quarterlyVisualsGroup)
showQuarterLabels    = input.bool(true, "Show A/M/D/C labels",    group = quarterlyVisualsGroup)
accumulationColor    = input.color(color.new(#2962FF, 85), "A — Accumulation", group = quarterlyVisualsGroup)
manipulationColor    = input.color(color.new(#E91E63, 85), "M — Manipulation", group = quarterlyVisualsGroup)
distributionColor    = input.color(color.new(#26A69A, 85), "D — Distribution", group = quarterlyVisualsGroup)
continuationColor    = input.color(color.new(#9E9E9E, 85), "C — Continuation", group = quarterlyVisualsGroup)

// ── Structure Engine (library-fed SMC: internal BOS/MSB + order blocks) ──
structureGroup = "Structure"
internalPivotLength   = input.int(10, "Internal pivot length", minval = 1, group = structureGroup, tooltip = "ammo.run internalLen — lower = more/earlier breaks. Drives BOS/MSB + OB anchoring.")
swingPivotLength      = input.int(50, "Swing pivot length", minval = 1, group = structureGroup, tooltip = "ammo.run swingLen — the reference an internal break must DIFFER from to validate. Always gates, even with confluence off.")
structureConfluence   = input.bool(true,  "Confluence filter", group = structureGroup, tooltip = "ammo.run confluence — also require a body-position confluence bar. On = fewer, cleaner breaks.")
structurePresentMode  = input.bool(false, "Present mode (reuse latest line)", group = structureGroup, tooltip = "ammo.run present — true reuses one structure line; false keeps each historical break line.")
showStructureBreaks   = input.bool(true, "Draw structure breaks", group = structureGroup)
bullishStructureColor = input.color(#089981, "Bullish colour", group = structureGroup)
bearishStructureColor = input.color(#f23645, "Bearish colour", group = structureGroup)

// ── Order Block Engine (library-fed via Sniper_Ammo SMC) ──
orderBlockGroup = "Order Blocks"
showOrderBlocks       = input.bool(true, "Show order blocks", group = orderBlockGroup)
maxOrderBlocksKept    = input.int(5, "Max OBs kept / drawn", minval = 1, maxval = 20, group = orderBlockGroup,
     tooltip = "Passed to the library SMC engine (run maxOB). ALSO bounds how many OBs DEX may trade — DEX only acts on the drawn set.")
orderBlockFilter      = input.string("Atr", "OB volatility filter", options = ["Atr", "Cumulative Mean Range"], group = orderBlockGroup,
     tooltip = "How the library anchors the OB candle. Atr = ATR(200); Cumulative Mean Range = running mean true range.")
orderBlockMitigation  = input.string("High/Low", "OB mitigation", options = ["Close", "High/Low"], group = orderBlockGroup,
     tooltip = "Close = OB dies only when price CLOSES through it. High/Low = a wick through removes it.")
demandOrderBlockColor = input.color(color.new(#3179f5, 0), "Demand (bull) OB colour", group = orderBlockGroup)
supplyOrderBlockColor = input.color(color.new(#f77c80, 0), "Supply (bear) OB colour", group = orderBlockGroup)

// ── DEX Signal Colours ──
dexColoursGroup = "DEX · Signal Colours"
dexLongColor  = input.color(color.new(#42A5F5, 0), "DEX Long colour",  group = dexColoursGroup)
dexShortColor = input.color(color.new(#FFB300, 0), "DEX Short colour", group = dexColoursGroup)

// ── DEX Re-entry Guard ──
// Without these, a stop-out returns the book to FLAT while the SAME order block
// is still drawn — so the very next bar re-arms on the setup that just failed.
// Three independent brakes, all checked at the arm.
dexGuardGroup = "DEX · Re-entry Guard"
dexBlockRetradedZone = input.bool(true, "Don't re-trade the same order block", group = dexGuardGroup,
     tooltip = "ROOT FIX. A zone that has already produced a signal is retired — it can never produce another, however many times price returns to it. This is what stops the same OB firing two or three times in a row.")
dexOneSignalPerQuarter = input.bool(true, "One signal per quarter", group = dexGuardGroup,
     tooltip = "At most one DEX fill per 15m quarter, whichever zone it came from.")
dexCooldownBars = input.int(15, "Cooldown after a signal (bars)", minval = 0, group = dexGuardGroup,
     tooltip = "No new arm until this many 1m bars have passed since the last fill. 0 = off. Runs alongside the two guards above, not instead of them.")

// ── Risk & Stats ──
riskStatsGroup = "Risk & Stats"
showTradeZoneBoxes = input.bool(true, "Show SL/TP zone boxes", group = riskStatsGroup)
showStatsTable     = input.bool(true, "Show stats table",      group = riskStatsGroup)
riskDollarsPerR    = input.float(50, "Risk per 1R ($, stats only)", minval = 1, group = riskStatsGroup)
moveStopToBreakeven = input.bool(true, "Move stop to breakeven at 50% of stop distance", group = riskStatsGroup,
     tooltip = "TRACKER ONLY — never touches alerts/EA. Once price moves 0.5R in favour, the tracked stop moves to entry and the trade runs to target. Exits at entry count as BE (0R), not a loss.")

// ── Unified Dashboard ──
dashboardGroup = "Unified Dashboard"
showUnifiedDashboard = input.bool(true, "Show SNIPER_DELTA dashboard", group = dashboardGroup)

// ═══════════════════════════════════════════════════════════════════════════
// CONFIG TYPES — the shape of an asset's configuration
// ═══════════════════════════════════════════════════════════════════════════
// Killzone schedule is HOST-HELD: a list of active CLOCK HOURS (ammo.KillzoneHour),
// each carrying which quarters (A/M/D/C) trade in that hour. The library query
// (ammo.isKillzoneOpen) reads the host's own hourLocal + quarterIndex — no separate
// time math, so it can't drift from the container/quarter clock. ONE killzone per
// asset, used by DEX (and any future DELTA strategy).
type KillzoneConfig
    bool   restrictEnabled
    array<ammo.KillzoneHour> activeHours

// Shared bias / volume settings.
type SharedConfig
    bool   volumeGateEnabled
    float  volumeThreshold
    int    biasConfirmCount

// Shared risk band. DEX derives a structural stop level (swing or OB edge), then
// this band gates it: a stop distance outside [min, max] % of entry → rejected.
type RiskConfig
    float  structuralStopMinPercent    // structural stop must sit at least this % from entry
    float  structuralStopMaxPercent    // ...and at most this % — outside the band → rejected

// DEX strategy.
//   emaTrendEnabled  : OPTIONAL 200-EMA trend filter
//   biasFilterEnabled: OPTIONAL ratified HTF quarter-bias filter
//   stopSource       : "Swing" (last SMC swing) or "OB Zone Edge" (armed OB edge)
//   riskRewardRatio  : target = this multiple of the stop distance
type DexConfig
    bool   enabled
    bool   emaTrendEnabled
    bool   biasFilterEnabled
    string stopSource
    float  riskRewardRatio

type AssetConfig
    string         assetCode
    bool           isKnownAsset
    SharedConfig   shared
    RiskConfig     risk
    KillzoneConfig killzone
    DexConfig      dex

// ── killzone helper ──────────────────────────────────────────────────────────
// Continuation model: within each active hour, A is OFF and M/D/C are ON.
// DEX arms in M or D (Q2/Q3); the fill lands the next bar in D or C — so the
// killzone opens M/D/C to cover both the arm quarters (M/D) and the fill (D/C).
continuationHour(int hourOfDay) =>
    ammo.KillzoneHour.new(hourOfDay, true, true, true, true)

// ═══════════════════════════════════════════════════════════════════════════
// PER-ASSET CONFIG — one self-contained block per asset (no base + override).
// Each block spells out EVERYTHING that asset uses: stop band, DEX tuning, and
// its killzone hours inline. Read one block top-to-bottom and you know exactly
// how that asset trades.
// ═══════════════════════════════════════════════════════════════════════════

// ── AUDUSD ──
buildConfigAUDJPY() =>
    array<ammo.KillzoneHour> killzoneHours = array.new<ammo.KillzoneHour>()                                   // Asia
    array.push(killzoneHours, continuationHour(9))
    array.push(killzoneHours, continuationHour(10))
    array.push(killzoneHours, continuationHour(11))
    array.push(killzoneHours, continuationHour(12))
    array.push(killzoneHours, continuationHour(13))
    array.push(killzoneHours, continuationHour(14))
    array.push(killzoneHours, continuationHour(15))
    array.push(killzoneHours, continuationHour(16))
    array.push(killzoneHours, continuationHour(17))
    array.push(killzoneHours, continuationHour(18))
    array.push(killzoneHours, continuationHour(19))
    array.push(killzoneHours, continuationHour(20))
    array.push(killzoneHours, continuationHour(21))
    array.push(killzoneHours, continuationHour(22))
    array.push(killzoneHours, continuationHour(23))
    AssetConfig.new("AUDJPY", true,
         SharedConfig.new(volumeGateEnabled = true, volumeThreshold = 1.5, biasConfirmCount = 1),
         RiskConfig.new(structuralStopMinPercent = 0.07, structuralStopMaxPercent = 0.10),
         KillzoneConfig.new(restrictEnabled = true, activeHours = killzoneHours),
         DexConfig.new(enabled = true, emaTrendEnabled = false, biasFilterEnabled = false, stopSource = "OB Zone Edge", riskRewardRatio = 2.0))

